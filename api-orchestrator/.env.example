# ─────────────────────────────────────────────────────────────────────────────
# api-orchestrator — Application Configuration
# Copy to .env and fill in values before starting.
# Fields marked [KMS] should be migrated to a managed secret store before prod.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3002
NODE_ENV=development

# Database
MONGO_URL=mongodb://localhost:27017/orchestrator
REDIS_URL=redis://localhost:6379

# [KMS] Session cookie signing secret
SESSION_SECRET=orchestrator-dev-secret-change-in-prod
SESSION_TTL_MS=28800000
SESSION_COOKIE_NAME=orch_sid

# [KMS] AES-256-GCM key for upstream secrets at rest — must be exactly 32 chars
SECRETS_ENCRYPTION_KEY=00000000000000000000000000000000

# [KMS] Bootstrap admin — seeded on first boot only when users collection is empty
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@1234567890

# Auth lockout policy
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000
AUTH_MIN_PASSWORD_LENGTH=12

# Upstream security
# Comma-separated allowed hostnames (subdomain wildcards: *.example.com)
UPSTREAM_HOST_ALLOWLIST=mock-server,localhost,host.docker.internal
UPSTREAM_BLOCK_PRIVATE_RANGES=true
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_MAX_RETRIES=3

# Circuit breaker
CIRCUIT_BREAKER_ERROR_THRESHOLD_PCT=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://api-config-dashboard:5000

# Telemetry
LOG_RETENTION_SECONDS=2592000
