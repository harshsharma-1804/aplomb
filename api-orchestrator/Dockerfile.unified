# ── Unified image: orchestrator API + dashboard SPA in one container ──────────
# Build context must be the REPO ROOT (needs both api-orchestrator/ and
# api-config-dashboard/). Used by docker-compose.sqlite.yml service
# "orchestrator-unified". The split deployment (Dockerfile.sqlite) is unchanged.

# ── Stage 1: build dashboard SPA ──────────────────────────────────────────────
FROM node:20-alpine AS dashboard-builder
WORKDIR /dashboard
COPY api-config-dashboard/package.json api-config-dashboard/package-lock.json* ./
RUN npm install --frozen-lockfile 2>/dev/null || npm install
COPY api-config-dashboard/ ./
RUN npm run build

# ── Stage 2: build orchestrator ────────────────────────────────────────────────
FROM node:22-alpine AS api-builder
WORKDIR /app
# better-sqlite3 needs python + make + g++ for native build
RUN apk add --no-cache python3 make g++
COPY api-orchestrator/package.json api-orchestrator/package-lock.json ./
RUN npm ci --ignore-scripts && npm rebuild better-sqlite3
COPY api-orchestrator/ ./
RUN npm run build

# ── Stage 3: runner ────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN apk add --no-cache libstdc++ libgcc \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 appuser

COPY --from=api-builder --chown=appuser:nodejs /app/dist ./dist
COPY --from=api-builder --chown=appuser:nodejs /app/src/db/migrations ./dist/db/migrations
COPY --from=api-builder --chown=appuser:nodejs /app/node_modules ./node_modules
COPY --from=api-builder --chown=appuser:nodejs /app/package.json ./

# Dashboard SPA — served by Express when DASHBOARD_DIST is set
COPY --from=dashboard-builder --chown=appuser:nodejs /dashboard/dist ./dashboard

RUN mkdir -p /app/data && chown appuser:nodejs /app/data

ENV DASHBOARD_DIST=/app/dashboard
USER appuser
EXPOSE 3002

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=6 \
  CMD node -e "require('http').get('http://localhost:3002/__health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "dist/index.js"]
